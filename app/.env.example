# Base URL of the EVOLVE backend API (see backend/.env.example for the server side).
# Must be reachable from the device/simulator running the app — "localhost" only
# works from an iOS simulator; use your machine's LAN IP for Android emulators/
# physical devices (e.g. http://192.168.1.20:8000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# User profile provider: "backend" (default) or "mock".
EXPO_PUBLIC_USER_PROVIDER=backend

# Coach Experience provider: "backend" (default), "mock", or "local".
# Production uses the FastAPI Coach API via BackendCoachExperienceService.
EXPO_PUBLIC_COACH_EXPERIENCE_PROVIDER=backend

# OpenAI Provider (Sprint 19.3) — never commit real secrets.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=30000
