# Environment separation: development | docker | production
# development = uvicorn on the host against Compose Postgres (localhost)
# docker      = set automatically by docker compose for the backend service
# production  = deployed Compose/host; set real secrets and CORS origins
APP_ENV=development

# Database (host development). Compose overrides DATABASE_URL inside the
# backend container to host `postgres` so the API can reach the DB network.
DATABASE_URL=postgresql+psycopg://evolve:evolve@localhost:5432/evolve

# Docker Compose (local production-like stack). Not secrets for production —
# override these in the real environment; never commit production values.
# Compose reads root `.env` and, if present, `backend/.env` (host uvicorn).
# DATABASE_URL inside the backend container is always overridden to host `postgres`.
POSTGRES_DB=evolve
POSTGRES_USER=evolve
POSTGRES_PASSWORD=evolve
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Application
APP_NAME=EVOLVE API
DEBUG=false
API_VERSION=1.0.0

# JWT — required. Generate a long random string for any non-local environment.
# Never commit real secrets.
JWT_SECRET_KEY=changeme-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=evolve-api

# Admin web app origins. Comma-separated list. Native mobile does not use CORS.
# Production must set the real Admin origin(s); do not hardcode production URLs.
CORS_ORIGINS=http://localhost:5173

# Workout logging
WORKOUT_LOG_EDIT_WINDOW_HOURS=24
DEFAULT_PROGRAM_SLUG=beginner-foundation

# AI Orchestrator
# AI_PROVIDER=mock uses the deterministic, offline MockLLMProvider (default).
# AI_PROVIDER=openai_compatible calls a real generic OpenAI-compatible endpoint
# (OpenAI itself, Azure OpenAI, OpenRouter, or a local OpenAI-compatible server)
# via the ai_llm_* settings below — AI_LLM_API_KEY is then required.
AI_PROVIDER=mock
AI_MEMORY_MAX_TURNS=20
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_API_KEY=changeme-your-llm-api-key
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_TIMEOUT_SECONDS=30.0
AI_LLM_MAX_OUTPUT_TOKENS=500

# Progress Analyzer
PROGRESS_MIN_DATA_POINTS_FOR_TREND=3
PROGRESS_PLATEAU_WINDOW_DAYS=14
PROGRESS_PLATEAU_THRESHOLD_PCT=2.0

# Nutrition Engine
NUTRITION_BMR_FORMULA=mifflin_st_jeor
NUTRITION_CALORIE_DEFICIT_KCAL=500
NUTRITION_CALORIE_SURPLUS_KCAL=300
NUTRITION_FAT_PCT_OF_CALORIES=0.25
NUTRITION_MIN_CALORIES_FLOOR=1200
NUTRITION_ADHERENCE_TOLERANCE_PCT=10
